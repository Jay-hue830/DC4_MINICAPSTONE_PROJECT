{
  "info": {
    "_postman_id": "86d8d4d9-f1f4-4c1e-85cf-2b7815ad17c6",
    "name": "Senior Citizen Assistance API",
    "description": "Local integration checks for authentication, role access, senior profiles, assistance requests, and dashboard statistics. Set baseUrl to the API root. Seeded credentials are for local development only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "seniorToken",
      "value": ""
    },
    {
      "key": "seniorCitizenId",
      "value": "1"
    },
    {
      "key": "requestId",
      "value": "1"
    },
    {
      "key": "assistanceTypeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register senior account and profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Maria\",\n  \"last_name\": \"Sample\",\n  \"email\": \"maria.sample@example.test\",\n  \"password\": \"SecurePass2026\",\n  \"password_confirmation\": \"SecurePass2026\",\n  \"birth_date\": \"1950-01-01\",\n  \"sex\": \"female\",\n  \"contact_number\": \"09171234567\",\n  \"address\": \"Purok 1, Rizal Street\",\n  \"barangay\": \"San Roque\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@seniorcare.test\",\n  \"password\": \"Admin#Care2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Login seeded senior",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('seniorToken', pm.response.json().data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lolita.santos@seniorcare.test\",\n  \"password\": \"Senior#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        },
        {
          "name": "Logout current token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin resources",
      "item": [
        {
          "name": "Dashboard statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "List senior citizens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/senior-citizens?per_page=10&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "senior-citizens"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "List senior citizens as senior (expect 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seniorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/senior-citizens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "senior-citizens"
              ]
            }
          }
        },
        {
          "name": "List senior citizens without token (expect 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/senior-citizens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "senior-citizens"
              ]
            }
          }
        },
        {
          "name": "Create senior with empty body (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/senior-citizens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "senior-citizens"
              ]
            }
          }
        },
        {
          "name": "Delete senior citizen with requests (expect 409)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/senior-citizens/{{seniorCitizenId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "senior-citizens",
                "{{seniorCitizenId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Assistance requests",
      "item": [
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assistance-requests?per_page=10&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "List own requests as senior",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seniorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assistance-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests"
              ]
            }
          }
        },
        {
          "name": "Create request as senior",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seniorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assistance_type_id\": {{assistanceTypeId}},\n  \"title\": \"Transportation to health center\",\n  \"description\": \"I need transport for my upcoming appointment.\",\n  \"date_needed\": \"2030-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assistance-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests"
              ]
            }
          }
        },
        {
          "name": "Senior tries status update (expect 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{seniorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assistance-requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests",
                "{{requestId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Approve request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assistance-requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests",
                "{{requestId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Reject request with remarks",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"admin_remarks\": \"Please provide the required supporting documents.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assistance-requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests",
                "{{requestId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Complete pending request (expect 422)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assistance-requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests",
                "{{requestId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Delete request",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assistance-requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistance-requests",
                "{{requestId}}"
              ]
            }
          }
        }
      ]
    }
  ]
